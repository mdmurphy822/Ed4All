# Defensive catch-all: ANY subdir under state/ holds runtime output — ignore its
# contents so a NEW runtime dir (e.g. state/benchmarks/, state/qa/) can never leak
# to git. Keep the .gitkeep placeholders. (Prevents "folders that just happen".)
state/*/*
!state/*/.gitkeep
# Operator working notes dropped at the state/ root (untracked scratch)
state/nvidia_*

runtime/

# Extraction scratch root (intake/extraction working dir — never committed)
extracted/

# Training captures (generated data)
training-captures/dart/*
!training-captures/dart/.gitkeep
training-captures/courseforge/*
!training-captures/courseforge/.gitkeep
training-captures/trainforge/*
!training-captures/trainforge/.gitkeep
