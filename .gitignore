# --- pre-push sanitization (2026-07-20) ---
# Per-run operator env stacks: carry real API keys (e.g. SPARK_API_KEY) + endpoint URLs.
run-env.*.sh
# The sanitized, portable template is the one tracked reference profile.
!run-env.example.sh
# Editor/operator backups
*.bak
# Regenerable derived caches (content-addressed embeddings; ~10MB, no corpus text)
runtime/state/embedding_cache*.jsonl

# No env-detail shell profiles tracked at project root (operator stacks live
# untracked; the sanitized template is docs/operations/run-env.example.sh)
/run-env*.sh

# Vendor model docs (NVIDIA Nemotron model cards) — local reference, not distributed
docs/vendor/

# Bloom-ladder initiative WI-13: operator-trained per-Bloom-level DeBERTa
# heads + their pre-seeded local base-model snapshot. GPU training
# artifacts (~400MB per head x 6, plus the base checkpoint) — never
# shipped in-repo; lib/classifiers/bloom_deberta_heads.py graceful-degrades
# to "no fourth voter" when these directories are absent (the default on a
# fresh checkout). Root-level, distinct from SemantiK/models/ above.
/models/base/
/models/bloom_classifiers/

# =============================================================================
# Operator archive outputs at repo root — support bundles + data-dir backups
# =============================================================================
# `ed4all support-bundle` / `ed4all backup` default (and are documented) to
# repo-root .tar.gz paths; the backup archives the full data dir, so these
# must never be committable.
ed4all-support*.tar.gz
ed4all-backup*.tar.gz

