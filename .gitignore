# =============================================================================
# Ed4All - LibV2 Content (preserve structure, exclude data)
# =============================================================================
# Course directories under LibV2/courses/ contain user-specific content
# (chunks.jsonl, graph/, quality/, retrieval/gold_queries.jsonl, ...). These
# are intentionally not tracked so this repository stays course-agnostic.
# Reference-retrieval fixtures live in
# LibV2/tools/libv2/tests/test_eval_harness_retrieval.py; users curate their
# own per-course gold queries locally (see docs/reference/reference-retrieval.md
# "Adding gold queries to your own corpus").
LibV2/courses/*
!LibV2/courses/.gitkeep
# LibV2/catalog/cross_package_concepts.json is regenerated on demand via
# ``libv2 cross-index`` against whatever courses a user has loaded locally;
# we do not ship a course-specific snapshot.
LibV2/catalog/*
!LibV2/catalog/.gitkeep

# =============================================================================
# Ed4All - Input/Output Directories
# =============================================================================

# Courseforge inputs (all subdirectories)
Courseforge/inputs/exam-objectives/*
!Courseforge/inputs/exam-objectives/.gitkeep
Courseforge/inputs/textbooks/*
!Courseforge/inputs/textbooks/.gitkeep
Courseforge/inputs/existing-packages/*
!Courseforge/inputs/existing-packages/.gitkeep
Courseforge/inputs/course-data/*
!Courseforge/inputs/course-data/.gitkeep

# Courseforge outputs
Courseforge/exports/*
!Courseforge/exports/.gitkeep
Courseforge/runtime/*
!Courseforge/runtime/.gitkeep

# Courseforge generated data files in scripts/
Courseforge/scripts/*.json

# SemantiK conversion batch output + dated scratch rounds (SemantiK/output/*
# + SemantiK/inputs/* are handled in the SemantiK section below).
SemantiK/batch_output/*
!SemantiK/batch_output/.gitkeep
SemantiK/output_*/

# Trainforge outputs
Trainforge/output/*
!Trainforge/output/.gitkeep

# =============================================================================
# Ed4All - runtime/ (the unified gitignored data root, 2026-07-29 reorg)
# =============================================================================
# Everything mutable lives under runtime/: state/, training-captures/, seats/,
# demo/, extracted/, testruns/, scratchpad/, shots/, and any new scratch dir
# (a new scratch dir gets runtime/<name>/, never a new repo root — see
# docs/architecture/repo-organization.md). Only .gitkeep sentinels are tracked;
# everything else under runtime/ stays local.
runtime/*
!runtime/state/
runtime/state/*
!runtime/state/*/
# Defensive catch-all: ANY subdir under runtime/state/ holds runtime output —
# ignore its contents so a NEW runtime dir (e.g. runtime/state/benchmarks/)
# can never leak to git. Keep the .gitkeep placeholders. (Prevents "folders
# that just happen".)
runtime/state/*/*
!runtime/state/*/.gitkeep
# Operator working notes dropped at the state root (untracked scratch)
runtime/state/nvidia_*
!runtime/training-captures/
runtime/training-captures/*
!runtime/training-captures/*/
runtime/training-captures/*/*
!runtime/training-captures/*/.gitkeep
# The legacy capture mirror dir holds pre-rename local capture data (never
# tracked); the ignore rule must outlive the code rename.
runtime/training-captures/dart/

# Retired root aliases remain ignored defensively so an old operator script
# cannot recreate mutable state outside runtime/. Canonical paths are the
# corresponding runtime/ directories above; no root aliases are supported.
/state
/training-captures
/seats

# MCP runtime
MCP/runtime/

