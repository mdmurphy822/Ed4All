# =============================================================================
.env
.env.*
*.pem
*.key
credentials.json
secrets.json

# Claude workspace
.claude/*
!.claude/skills/
!.claude/skills/**
!.claude/agents/
!.claude/agents/**

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
runtime/state/GENERATION_PROGRESS.md

# Examples — sample fixtures + generated output, kept local-only
examples/

# Top-level inputs/ — corpus PDFs + local scratch; directory kept, contents ignored
inputs/*
!inputs/.gitkeep

# Codex CLI sentinel — empty marker file the agent leaves; not project state
.codex

# Wave 116: sidecar files written incrementally during synthesis runs.
# Cleaned up at end of clean runs; preserved on budget-exceeded exits.
*.jsonl.in_progress

# =============================================================================
# Defense-in-depth: model weights & training data MUST NOT land on GitHub
# =============================================================================
# Course-local artifacts under LibV2/courses/* are already excluded above.
# These globs catch the same artifact classes anywhere else in the tree
# (test scratch dirs, temp staging, accidental top-level writes), so a new
# code path that emits to a non-LibV2 location can't silently expose
# datasets, adapters, or eval reports.
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.bin
adapter_model.*
adapter_config.json

# Training data (any path)
**/instruction_pairs.jsonl
**/preference_pairs.jsonl
**/instruction_pairs.jsonl.bak
**/preference_pairs.jsonl.bak
**/instruction_pairs.jsonl.*.bak
**/preference_pairs.jsonl.*.bak

# Eval / model-card outputs (any path)
**/eval_report.json
**/ablation_report.json
**/model_card.json
**/eval_traces.jsonl
**/eval_progress.jsonl
**/pilot_report.md
**/pilot_progress.json
**/.synthesis_cache.jsonl
**/.synthesis_telemetry.jsonl

# Hugging Face upload staging directories
hf_uploads/
huggingface/

# Local-LLM-generated FORM_DATA catalog overlays.
# Operating principle: anything an Ollama / local / cloud LLM provider
# emits stays local-only — license posture (Apache 2.0 for Qwen, etc.)
# permits training use, but the project's standing policy is that
# generated corpus content does not live in git history. The Python
# in-source fallback (_RDF_SHACL_FALLBACK_FORM_DATA in
# Trainforge/generators/schema_translation_generator.py) is the
# tracked source of truth for the 6 hand-curated entries; the
# per-family overlay YAML is the operator-local extension where
# Qwen-generated entries land via the Wave 137 backfill loop.
# .schema.json contracts stay tracked (hand-authored).
schemas/training/schema_translation_catalog.*.yaml

# Allow-list — fixtures for tests must stay tracked
!Trainforge/tests/fixtures/**/instruction_pairs.jsonl
!Trainforge/tests/fixtures/**/preference_pairs.jsonl
!Trainforge/tests/fixtures/**/eval_report.json
!Trainforge/tests/fixtures/**/model_card.json

# =============================================================================
# Plans directory — local-only working notes, never committed
# =============================================================================
plans/
plan/

# Operator-only documentation retained locally during the public-doc rebuild.
# Tracked publication is allowlisted by review; cleanup evidence and detailed
# machine-seat topology are not source-release dependencies.
/docs/reference/repository-cleanup.md
/docs/architecture/gpu-seat-residency.md

# Local regression retirement shelves. Every scripts container may retain
# proven obsolete scripts here without publishing them or treating them as a
# build/test dependency. The recursive form covers subsystem and nested
# taxonomies such as Trainforge/scripts/harness/regression/.
**/scripts/regression/
**/scripts/**/regression/

# Third-party IMS Common Cartridge / W3C XML schemas are operator-installed
# dependencies, not Ed4All source. Keep the first-party installation README.
/Courseforge/schemas/imscc/*.xsd
/ms-playwright/
/.cache/ms-playwright/

# =============================================================================
# Windows-from-WSL leftovers
# =============================================================================
# When a `.docx` is copied from Windows into WSL, NTFS attaches a
# `:Zone.Identifier` alternate-data-stream sidecar that surfaces in the
# Linux view as a separate file. These are never project content.
*:Zone.Identifier

# Local-only generated indexes and release-review evidence. These files may
# contain machine-, corpus-, campaign-, or run-specific details and are not
# part of the public documentation surface.
/docs/MANIFEST.md
/docs/FILE_MANIFEST.md
/docs/TECH_DEBT.md
/docs/file-audit-cleanup.md
/docs/operations/full-run-inventory.md
/docs/validation/enrichment-trace-report.md
/docs/validation/gate-history.md
/docs/validation/ontology-review-v0.2.0.md
/docs/validation/summary-retrieval-delta-v0.2.0.md
/docs/validation/typed-edges-v0.2.0.md
/schemas/ONTOLOGY_LO_AUDIT.md
docker-compose.override.yml

# Untracked operator runbook for the big-memory concurrent-serving profile.
# Kept local-only so it can name the specific target hardware freely (tracked
# docs stay machine-name-free per the hygiene contract).
/docs/operations/spark-profile.md

