{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed4all.dev/ns/eval/v1/generation_quality_curve.schema.json",
  "title": "Ed4All generation_quality_curve.json",
  "description": "C0..C5 technique-curve report (W5 §6.2). Per-arm generation-quality headline + success_condition, plus per-technique deltas (how much each lever buys on 7B) and a C5 ceiling block reserving a Spark C5-70b row. Built by Trainforge/eval/generation_curve_runner.py::run_generation_curve, modeled on Trainforge/eval/ablation_runner.py + headline_delta.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "course_slug",
    "generated_at",
    "provenance",
    "arms",
    "deltas",
    "ceiling"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version. 1.0 == W5 land."
    },
    "course_slug": { "type": "string" },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["best_of_n", "single_corpus_caveat"],
      "properties": {
        "nli_model_revision": { "type": ["string", "null"] },
        "embedding_provider": { "type": ["string", "null"] },
        "best_of_n": { "type": "integer", "minimum": 1 },
        "single_corpus_caveat": { "type": "boolean" }
      }
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["mode", "arm_basis", "headline"],
        "properties": {
          "mode": { "type": "string" },
          "arm_basis": {
            "type": "string",
            "enum": ["resynthesized", "reselected"],
            "description": "Whether this arm re-ran synthesis (generation-change) or re-applied only the selector to a fixed pool (selection-change). Keeps the delta honestly attributed (§6.1)."
          },
          "headline": { "type": "object" },
          "success_condition": { "type": ["object", "null"] }
        }
      }
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["from", "to", "technique"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "technique": { "type": "string" },
          "block_prose_grounding_rate": { "type": ["number", "null"] },
          "contradicted_block_count": { "type": ["integer", "null"] },
          "objective_grounding_rate": { "type": ["number", "null"] }
        }
      }
    },
    "ceiling": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "note"],
      "properties": {
        "mode": { "type": "string" },
        "block_prose_grounding_rate": { "type": ["number", "null"] },
        "note": { "type": "string" }
      }
    },
    "_written": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
