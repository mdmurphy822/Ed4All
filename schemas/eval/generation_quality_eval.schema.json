{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed4all.dev/ns/eval/v1/generation_quality_eval.schema.json",
  "title": "Ed4All generation_quality_eval.json",
  "description": "Per-course-per-technique generation-quality eval report (W5 §1.9). Scores synthesized objectives + emitted instructional blocks: NLI grounding rates (headline), provenance-completeness, concept-coverage, Bloom-distribution sanity, objective dedup, the four course_planning hierarchy gates + block-objective-delivery, and downstream usability. Built by lib/objectives/generation_quality_eval.py::run_generation_quality_eval. Modeled on the measure-then-pin discipline of lib/retrieval/grounded_eval.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "course_slug",
    "technique_config",
    "generated_at",
    "provenance",
    "counts",
    "headline",
    "hierarchy_gates",
    "provenance_audit",
    "downstream",
    "diagnostics",
    "blocks",
    "objectives",
    "success_condition",
    "review_sample"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version. 1.0 == W5 land."
    },
    "course_slug": { "type": "string" },
    "technique_config": {
      "type": "string",
      "description": "Which C0..C5 mode produced these artifacts (label only)."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of the build call."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["single_corpus_caveat"],
      "properties": {
        "nli_model_revision": { "type": ["string", "null"] },
        "nli_device": { "type": ["string", "null"] },
        "embedding_provider": { "type": ["string", "null"] },
        "embedding_model": { "type": ["string", "null"] },
        "thresholds_provenance": { "type": ["string", "null"] },
        "single_corpus_caveat": { "type": "boolean" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "total_blocks",
        "scored_blocks",
        "skipped_scaffold_blocks",
        "total_objectives",
        "scored_objectives",
        "objectives_unscorable"
      ],
      "properties": {
        "total_blocks": { "type": "integer", "minimum": 0 },
        "scored_blocks": { "type": "integer", "minimum": 0 },
        "skipped_scaffold_blocks": { "type": "integer", "minimum": 0 },
        "total_objectives": { "type": "integer", "minimum": 0 },
        "scored_objectives": { "type": "integer", "minimum": 0 },
        "objectives_unscorable": { "type": "integer", "minimum": 0 }
      }
    },
    "headline": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "block_prose_grounding_rate",
        "objective_grounding_rate",
        "provenance_completeness_rate",
        "mean_block_entailment_rate",
        "contradicted_block_count",
        "objective_unsupported_rate",
        "objective_contradicted_count",
        "chunk_coverage_rate",
        "concept_coverage_rate",
        "bloom",
        "objective_dedup",
        "hierarchy_valid",
        "block_lo_reference_rate",
        "windowed_rescue_share"
      ],
      "properties": {
        "block_prose_grounding_rate": { "$ref": "#/$defs/rateOrNull" },
        "objective_grounding_rate": { "$ref": "#/$defs/rateOrNull" },
        "provenance_completeness_rate": { "$ref": "#/$defs/rateOrNull" },
        "mean_block_entailment_rate": { "$ref": "#/$defs/rateOrNull" },
        "contradicted_block_count": { "type": "integer", "minimum": 0 },
        "objective_unsupported_rate": { "$ref": "#/$defs/rateOrNull" },
        "objective_contradicted_count": { "type": "integer", "minimum": 0 },
        "chunk_coverage_rate": { "$ref": "#/$defs/rateOrNull" },
        "concept_coverage_rate": { "$ref": "#/$defs/rateOrNull" },
        "bloom": {
          "type": "object",
          "additionalProperties": true,
          "required": ["histogram", "distinct_levels", "max_share", "collapse"],
          "properties": {
            "histogram": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "distinct_levels": { "type": "integer", "minimum": 0 },
            "max_share": { "$ref": "#/$defs/rateOrNull" },
            "collapse": { "type": "boolean" }
          }
        },
        "objective_dedup": {
          "type": "object",
          "additionalProperties": true,
          "required": ["max_pairwise_cosine", "near_dup_pairs", "dedup_clean"],
          "properties": {
            "max_pairwise_cosine": { "type": ["number", "null"] },
            "near_dup_pairs": { "type": ["integer", "null"], "minimum": 0 },
            "dedup_clean": { "type": ["boolean", "null"] }
          }
        },
        "hierarchy_valid": { "type": "boolean" },
        "block_lo_reference_rate": { "$ref": "#/$defs/rateOrNull" },
        "windowed_rescue_share": { "$ref": "#/$defs/rateOrNull" }
      }
    },
    "hierarchy_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["gate_id", "passed"],
        "properties": {
          "gate_id": { "type": "string" },
          "passed": { "type": "boolean" },
          "action": { "type": ["string", "null"] },
          "critical_count": { "type": "integer", "minimum": 0 },
          "score": { "type": ["number", "null"] },
          "issue_codes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "provenance_audit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["manifest_chunk_resolution_rate", "manifest_matches_cited_rate"],
      "properties": {
        "manifest_chunk_resolution_rate": { "$ref": "#/$defs/rateOrNull" },
        "manifest_matches_cited_rate": { "$ref": "#/$defs/rateOrNull" }
      }
    },
    "downstream": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "served_answer_eval": { "type": ["object", "null"] }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "computational_claim_count": { "type": "integer", "minimum": 0 },
        "filtered_claim_count": { "type": "integer", "minimum": 0 }
      }
    },
    "reference_set_similarity": {
      "type": ["object", "null"],
      "description": "Optional anchor-not-truth signal (§1.10): bipartite-match each emitted objective to its nearest cloud-reference by embedding cosine. interpretation MUST be 'anchor_not_truth'.",
      "additionalProperties": true
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["block_id", "block_type", "grounded"],
        "properties": {
          "block_id": { "type": "string" },
          "block_type": { "type": "string" },
          "entailment_rate": { "$ref": "#/$defs/rateOrNull" },
          "contradicted": { "type": "boolean" },
          "manifest_complete": { "type": ["boolean", "null"] },
          "grounded": { "type": ["boolean", "null"] }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "grounded"],
        "properties": {
          "id": { "type": "string" },
          "grounded": { "type": ["boolean", "null"] },
          "entailment": { "$ref": "#/$defs/rateOrNull" },
          "contradicted": { "type": "boolean" },
          "cited_chunk_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "success_condition": { "$ref": "#/$defs/SuccessCondition" },
    "review_sample": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "course_slug", "sample_seed", "samples"],
      "properties": {
        "schema_version": { "type": "string" },
        "course_slug": { "type": "string" },
        "sample_seed": { "type": "string" },
        "n_sampled": { "type": "integer", "minimum": 0 },
        "n_items": { "type": "integer", "minimum": 0 },
        "samples": { "type": "array", "items": { "type": "object" } }
      }
    },
    "_written": {
      "type": "object",
      "additionalProperties": true,
      "description": "Present only when write=True; records the emitted file path(s)."
    }
  },
  "$defs": {
    "rateOrNull": {
      "type": ["number", "null"],
      "description": "A [0,1] rate, or null when the dependent backend (NLI/embedding/manifest) was absent (honest degrade, never a fabricated 0.0/1.0)."
    },
    "Pillar": {
      "type": "object",
      "additionalProperties": true,
      "required": ["metric", "value", "threshold", "met"],
      "properties": {
        "metric": { "type": "string" },
        "value": { "type": ["number", "null"] },
        "threshold": { "type": "number" },
        "met": { "type": "boolean" },
        "and": { "type": "string" }
      }
    },
    "SuccessCondition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["met", "pillars", "hard_zeros", "pinned_at", "single_corpus_caveat"],
      "properties": {
        "met": { "type": "boolean" },
        "pillars": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "every_block_grounded",
            "every_block_provenanced",
            "concept_metadata_correct",
            "objectives_grounded_valid"
          ],
          "properties": {
            "every_block_grounded": { "$ref": "#/$defs/Pillar" },
            "every_block_provenanced": { "$ref": "#/$defs/Pillar" },
            "concept_metadata_correct": { "$ref": "#/$defs/Pillar" },
            "objectives_grounded_valid": { "$ref": "#/$defs/Pillar" }
          }
        },
        "hard_zeros": {
          "type": "object",
          "additionalProperties": true,
          "required": ["contradicted_block_count", "objective_contradicted_count"],
          "properties": {
            "contradicted_block_count": { "type": "integer", "minimum": 0 },
            "objective_contradicted_count": { "type": "integer", "minimum": 0 }
          }
        },
        "pinned_at": {
          "type": "string",
          "description": "MEASURE-FIRST until the first real C5 run pins the floors against a measured clean run."
        },
        "single_corpus_caveat": { "type": "boolean" }
      }
    }
  }
}
