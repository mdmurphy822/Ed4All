{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed4all.dev/ns/taxonomies/v1/teaching_role.schema.json",
  "title": "Teaching Role",
  "description": "Pedagogical function played by a chunk within a course: introduce, elaborate, reinforce, assess, transfer, synthesize. Emitted on Trainforge chunks after alignment and by Courseforge through a deterministic component-and-purpose mapping.",
  "$comment": "Values match Trainforge/alignment/align_chunks.py::VALID_ROLES. The x-component-mapping array is the deterministic mapping from Courseforge data-cf-component and data-cf-purpose values to teaching_role values.",
  "$defs": {
    "TeachingRole": {
      "type": "string",
      "enum": [
        "introduce",
        "elaborate",
        "reinforce",
        "assess",
        "transfer",
        "synthesize"
      ]
    },
    "ComponentMappingEntry": {
      "type": "object",
      "required": ["component", "purpose", "teaching_role"],
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string",
          "description": "Value of the data-cf-component HTML attribute."
        },
        "purpose": {
          "type": "string",
          "description": "Value of the data-cf-purpose HTML attribute."
        },
        "teaching_role": {
          "$ref": "#/$defs/TeachingRole"
        },
        "source": {
          "type": "string",
          "description": "Source citation (file:line) where the component+purpose pair is emitted."
        }
      }
    }
  },
  "$ref": "#/$defs/TeachingRole",
  "x-component-mapping": [
    {
      "component": "flip-card",
      "purpose": "term-definition",
      "teaching_role": "introduce",
      "source": "Courseforge/scripts/rendering/generate_course.py:345"
    },
    {
      "component": "self-check",
      "purpose": "formative-assessment",
      "teaching_role": "assess",
      "source": "Courseforge/scripts/rendering/generate_course.py:374"
    },
    {
      "component": "activity",
      "purpose": "practice",
      "teaching_role": "transfer",
      "source": "Courseforge/scripts/rendering/generate_course.py:487"
    },
    {
      "component": "concept",
      "purpose": "introduce-concept",
      "teaching_role": "introduce",
      "source": "MCP/tools/pipeline_tools.py::_run_content_generation_rewrite (7B parity Wave 1)"
    },
    {
      "component": "definition",
      "purpose": "introduce-concept",
      "teaching_role": "introduce",
      "source": "MCP/tools/pipeline_tools.py::_run_content_generation_rewrite (7B parity Wave 1)"
    },
    {
      "component": "explanation",
      "purpose": "elaborate-concept",
      "teaching_role": "elaborate",
      "source": "MCP/tools/pipeline_tools.py::_run_content_generation_rewrite (7B parity Wave 1)"
    },
    {
      "component": "example",
      "purpose": "demonstrate",
      "teaching_role": "elaborate",
      "source": "MCP/tools/pipeline_tools.py::_run_content_generation_rewrite (7B parity Wave 1)"
    },
    {
      "component": "summary",
      "purpose": "consolidate",
      "teaching_role": "synthesize",
      "source": "MCP/tools/pipeline_tools.py::_run_content_generation_rewrite (7B parity Wave 1)"
    },
    {
      "component": "recap",
      "purpose": "review",
      "teaching_role": "reinforce",
      "source": "MCP/tools/pipeline_tools.py::_run_content_generation_rewrite (7B parity Wave 1)"
    }
  ]
}
