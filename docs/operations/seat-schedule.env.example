# ============================================================================
# seat-schedule.env.example — pipeline-owned vLLM seat lifecycle (FUTURE runs)
#
# Source this alongside your run-env BEFORE `ed4all run` to have the pipeline
# OWN model-seat lifecycle at phase boundaries: stop the seats a phase does not
# need, start + WAIT (health-check poll, not a blind sleep) for the ones it does,
# and AUTOMATICALLY cold-recreate a seat that mode-collapses on a warm start
# (the documented "vLLM seat mode-collapses after docker start" failure).
#
# SETUP for future runs — do NOT apply this to a live run mid-build. Adjust the
# seat names / URLs / container names / launch-script paths to your box.
# Full reference: docs/operations/behavior-flags.md § Seat-schedule config recipe.
# ============================================================================

# 1. Master switch — enforce each phase's config/workflows.yaml `seats:` block.
export ED4ALL_SEAT_SCHEDULE=1

# 2. Logical seat name -> vLLM base URL (names match the workflows.yaml seats:).
export ED4ALL_SEAT_BASE_URLS="spark-glm=http://localhost:8002,spark-qwen=http://localhost:8003,spark-super=http://localhost:8001"

# 3. base URL -> docker container name (the single container registry).
export ED4ALL_VLLM_CONTAINERS="http://localhost:8002=vllm-glmocr,http://localhost:8003=vllm-qwen30,http://localhost:8001=vllm-super-final"

# 4. Seat -> its launch SCRIPT (ops-owned; the cold-recreate self-heal path).
#    A script path keeps the long spec-decode Super command out of the env. Use
#    ';' as the token separator so a command containing ',' still parses; each
#    token splits on its FIRST '=' only, so the spec may itself contain '='.
export ED4ALL_SEAT_LAUNCH_SPECS="spark-glm=/opt/seats/launch-glmocr.sh;spark-qwen=/opt/seats/launch-qwen30.sh;spark-super=/opt/seats/launch-super-final.sh"

# 5. LIVENESS load-wait CEILING (seconds). Bounds ONLY the wait for /v1/models to
#    answer 200; NOT a fixed sleep — returns the moment the seat is live. 1200s
#    (20 min) comfortably covers a 120B NVFP4 cold load (~8-10 min observed).
export ED4ALL_SEAT_LOAD_TIMEOUT_SECONDS=1200

# 6. BOUNDED content-coherence attempts once the seat is LIVE (default 3). A
#    mode-collapse is live-but-incoherent and caught in seconds → cold-recreated
#    IMMEDIATELY, never riding out the liveness ceiling above.
export ED4ALL_SEAT_COHERENCE_ATTEMPTS=3
