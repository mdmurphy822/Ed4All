# Pipeline-managed model-seat lifecycle example.
#
# Copy this template to an ignored operator-local environment file, replace
# every example value, and source that private file before `ed4all run`.
# Never commit real seat names, ports, launch paths, container names, hardware
# limits, timing observations, or machine topology.
#
# Reference: docs/operations/behavior-flags.md, "Seat-schedule config recipe".

# Enable phase-boundary seat reconciliation from config/workflows.yaml.
export ED4ALL_SEAT_SCHEDULE=1

# Require operator-local endpoints before constructing the scheduler maps.
# Keep these values in the ignored private copy; they must include the API root
# but not the `/v1` suffix.
: "${ED4ALL_PRIVATE_SEAT_A_URL:?set ED4ALL_PRIVATE_SEAT_A_URL privately}"
: "${ED4ALL_PRIVATE_SEAT_B_URL:?set ED4ALL_PRIVATE_SEAT_B_URL privately}"

# Map logical workflow seat names to OpenAI-compatible base URLs.
export ED4ALL_SEAT_BASE_URLS="seat-a=${ED4ALL_PRIVATE_SEAT_A_URL},seat-b=${ED4ALL_PRIVATE_SEAT_B_URL}"

# Map each base URL to the local container that serves it.
export ED4ALL_VLLM_CONTAINERS="${ED4ALL_PRIVATE_SEAT_A_URL}=model-seat-a,${ED4ALL_PRIVATE_SEAT_B_URL}=model-seat-b"

# Map each seat to an absolute operator-owned launch script. Semicolons separate
# entries, and each entry splits on its first equals sign.
export ED4ALL_SEAT_LAUNCH_SPECS="seat-a=/absolute/path/to/launch-seat-a.sh;seat-b=/absolute/path/to/launch-seat-b.sh"

# Bound the liveness wait for /v1/models. This is a ceiling, not a fixed sleep;
# set it privately for the operator's deployment.
export ED4ALL_SEAT_LOAD_TIMEOUT_SECONDS=600

# Bound live-but-incoherent health probes before cold recreation.
export ED4ALL_SEAT_COHERENCE_ATTEMPTS=3

# Optional heading-judge routing. Point this at the private seat selected for
# heading judgment; do not publish its real endpoint or capacity.
export SEMANTIK_HEADING_JUDGE_BASE_URL="${ED4ALL_PRIVATE_SEAT_B_URL}/v1"

# Derive context budgets from the selected seat's reported model metadata.
export SEMANTIK_HEADING_JUDGE_SEAT_CONTEXT=auto

# Estimate the per-judgment budget. Tune this only in the ignored private copy.
export SEMANTIK_HEADING_JUDGE_EST_PER_JUDGMENT=300

# Optional explicit budget overrides remain available through:
# SEMANTIK_HEADING_JUDGE_MAX_TOKENS
# SEMANTIK_HEADING_JUDGE_CTX_BUDGET
# SEMANTIK_HEADING_JUDGE_DIGEST_BUDGET
