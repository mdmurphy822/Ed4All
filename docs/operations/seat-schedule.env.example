# ============================================================================
# seat-schedule.env.example — pipeline-owned vLLM seat lifecycle (FUTURE runs)
#
# Source this alongside your run-env BEFORE `ed4all run` to have the pipeline
# OWN model-seat lifecycle at phase boundaries: stop the seats a phase does not
# need, start + WAIT (health-check poll, not a blind sleep) for the ones it does,
# and AUTOMATICALLY cold-recreate a seat that mode-collapses on a warm start
# (the documented "vLLM seat mode-collapses after docker start" failure).
#
# SETUP for future runs — do NOT apply this to a live run mid-build. Adjust the
# seat names / URLs / container names / launch-script paths to your box.
# Full reference: docs/operations/behavior-flags.md § Seat-schedule config recipe.
# ============================================================================

# 1. Master switch — enforce each phase's config/workflows.yaml `seats:` block.
export ED4ALL_SEAT_SCHEDULE=1

# 2. Logical seat name -> vLLM base URL (names match the workflows.yaml seats:).
#    spark-super  = the 65k/128-seq synthesis Super (course_planning, two-pass
#                   outline/rewrite, assessment, etc.).
#    spark-super-hj = a BIG-CONTEXT 250k/4-seq Super variant that serves ONLY the
#                   heading_judge phase. It is a MUTUALLY-EXCLUSIVE second Super
#                   config, so it MUST live on a DISTINCT base URL/port (8011) —
#                   the container is resolved via the URL, and the schedule's
#                   stop-before-start reconcile swaps the 65k Super out before it
#                   starts the 250k one (OOM-safe on a single card).
export ED4ALL_SEAT_BASE_URLS="spark-glm=http://localhost:8002,spark-qwen=http://localhost:8003,spark-super=http://localhost:8001,spark-super-hj=http://localhost:8011"

# 3. base URL -> docker container name (the single container registry).
export ED4ALL_VLLM_CONTAINERS="http://localhost:8002=vllm-glmocr,http://localhost:8003=vllm-qwen30,http://localhost:8001=vllm-super-final,http://localhost:8011=vllm-super-hj"

# 4. Seat -> its launch SCRIPT (ops-owned; the cold-recreate self-heal path).
#    A script path keeps the long spec-decode Super command out of the env. Use
#    ';' as the token separator so a command containing ',' still parses; each
#    token splits on its FIRST '=' only, so the spec may itself contain '='.
#    launch-super-hj.sh is the 250k/4-seq Super (example at
#    docs/operations/launch-super-hj.sh.example — review + copy to /opt/seats).
export ED4ALL_SEAT_LAUNCH_SPECS="spark-glm=/opt/seats/launch-glmocr.sh;spark-qwen=/opt/seats/launch-qwen30.sh;spark-super=/opt/seats/launch-super-final.sh;spark-super-hj=/opt/seats/launch-super-hj.sh"

# 5. LIVENESS load-wait CEILING (seconds). Bounds ONLY the wait for /v1/models to
#    answer 200; NOT a fixed sleep — returns the moment the seat is live. 1200s
#    (20 min) comfortably covers a 120B NVFP4 cold load (~8-10 min observed).
export ED4ALL_SEAT_LOAD_TIMEOUT_SECONDS=1200

# 6. BOUNDED content-coherence attempts once the seat is LIVE (default 3). A
#    mode-collapse is live-but-incoherent and caught in seconds → cold-recreated
#    IMMEDIATELY, never riding out the liveness ceiling above.
export ED4ALL_SEAT_COHERENCE_ATTEMPTS=3

# 7. Big-context heading-judge budgets (the 250k/4-seq spark-super-hj seat).
#    These ONLY affect the heading_judge phase and ONLY bite while the 250k seat
#    is resident — the schedule swaps it in for heading_judge and back out to the
#    65k synthesis Super, so on a run WITHOUT this schedule they change nothing
#    the judge could not already do on the 65k seat's smaller ceilings.
#
#    Point the judge at the 250k seat's own port (matches spark-super-hj above):
export SEMANTIK_HEADING_JUDGE_BASE_URL=http://localhost:8011/v1
#
#    SEAT-ADAPTIVE budgets (default): the judge reads its own seat's
#    --max-model-len (GET {BASE_URL}/v1/models -> max_model_len) ONCE and DERIVES
#    every per-window budget to fit, so the invariant
#    digest_budget + completion_ceiling <= seat_context holds BY CONSTRUCTION —
#    no hand-math, no MAX_TOKENS/CTX_BUDGET numbers to keep in sync with the
#    seat. Just point BASE_URL at the seat and leave SEAT_CONTEXT=auto (default).
export SEMANTIK_HEADING_JUDGE_SEAT_CONTEXT=auto
#    EST_PER_JUDGMENT stays the thinking-budget knob (NOT derived): 2000 covers
#    the measured ~1875-tok/pending worst case so a thinking-heavy window's
#    budget (floor + est*n) does not truncate, and it widens the pending-window
#    cap toward chapter-sized windows on the big seat. Default 300 (unset) is the
#    byte-identical 65k-safe value.
export SEMANTIK_HEADING_JUDGE_EST_PER_JUDGMENT=2000
#
#    (Optional MANUAL override: set SEMANTIK_HEADING_JUDGE_{MAX_TOKENS,CTX_BUDGET,
#    DIGEST_BUDGET} to pin a budget explicitly — each OVERRIDES the seat-derived
#    value for that budget. SEMANTIK_HEADING_JUDGE_SEAT_CONTEXT=off reverts to the
#    hardcoded 65k-seat 24000/31500/30000 budgets byte-identically.)
#
#    NOTE: mirror the SEMANTIK_HEADING_JUDGE_* exports above into your ACTUAL
#    run-env (or keep them here and source this file after run-env).
