{
  "$schema": "repository-layout.schema.json",
  "root_files": [
    ".dockerignore", ".gitignore", "AGENTS.md", "ARCHITECTURE.md", "CLAUDE.md",
    "CONTRIBUTING.md", "Dockerfile", "Dockerfile.gui", "LICENSE", "Makefile",
    "NOTICE", "README.md", "VERSIONING.md", "conftest.py", "docker-compose.yml",
    "pyproject.toml", "pytest.ini", "run-gui.bat", "run-gui.sh"
  ],
  "public_docs": [
    "docs/LICENSING.md",
    "docs/architecture/ADR-001-pipeline-shape.md",
    "docs/architecture/ADR-002-retrieval-scope.md",
    "docs/architecture/ADR-003-two-pass-content-generation.md",
    "docs/architecture/ADR-004-phase-name-dispatch.md",
    "docs/architecture/ADR-005-gate-severity-blocking.md",
    "docs/architecture/aggregators.md",
    "docs/architecture/block-ontology.md",
    "docs/architecture/chunk-schema-v4.md",
    "docs/architecture/decision-capture.md",
    "docs/architecture/hybrid-vision-extraction.md",
    "docs/architecture/pipeline-flow.md",
    "docs/architecture/repo-organization.md",
    "docs/architecture/repository-layout.json",
    "docs/architecture/repository-layout.schema.json",
    "docs/architecture/retrieval-and-serving.md",
    "docs/architecture/typed-edges.md",
    "docs/architecture/validation-architecture.md",
    "docs/operations/backup-restore.md",
    "docs/operations/behavior-flags-courseforge.md",
    "docs/operations/behavior-flags-semantik.md",
    "docs/operations/behavior-flags-trainforge.md",
    "docs/operations/behavior-flags.md",
    "docs/operations/convert-verb.md",
    "docs/operations/demo-course.md",
    "docs/operations/development-token-stats.md",
    "docs/operations/docker.md",
    "docs/operations/expanded-adapter-evaluation.md",
    "docs/operations/flow-metrics.md",
    "docs/operations/full-run-playbook.md",
    "docs/operations/installation.md",
    "docs/operations/launch-seat.example.sh",
    "docs/operations/launch-super-hj.sh.example",
    "docs/operations/learner-ui-manual-pass.md",
    "docs/operations/library-versioning.md",
    "docs/operations/license-clean-run.md",
    "docs/operations/nemotron-lora-canary.md",
    "docs/operations/pipeline-invocation.md",
    "docs/operations/reject-mined-dpo-negatives.md",
    "docs/operations/run-env.example.sh",
    "docs/operations/seat-schedule.env.example",
    "docs/operations/seat-scripts.md",
    "docs/operations/super-synthesis-benchmark.md",
    "docs/operations/support-bundle.md",
    "docs/reference/audit-trail.md",
    "docs/reference/cross-package-index.md",
    "docs/reference/development-token-stats.json",
    "docs/reference/reference-retrieval.md",
    "docs/validation/gates.md",
    "docs/validation/validators.md"
  ],
  "roots": {
    ".claude": "agent-tooling", ".github": "ci", "ci": "ci", "cli": "surface",
    "config": "contracts", "Courseforge": "subsystem", "docs": "docs", "gui": "surface",
    "inputs": "external-var", "lib": "package", "LibV2": "subsystem", "MCP": "package",
    "runtime": "external-var", "schemas": "contracts", "scripts": "tools",
    "SemantiK": "subsystem", "tests": "tests", "Trainforge": "subsystem"
  },
  "overrides": [
    {"pattern": "**/tests", "role": "tests"},
    {"pattern": "**/tests/**", "role": "tests"},
    {"pattern": "**/fixtures", "role": "fixtures"},
    {"pattern": "**/fixtures/**", "role": "fixtures"},
    {"pattern": "Courseforge/templates", "role": "templates"},
    {"pattern": "Courseforge/templates/**", "role": "templates"},
    {"pattern": "Courseforge/inputs", "role": "external-var"},
    {"pattern": "Courseforge/inputs/**", "role": "external-var"},
    {"pattern": "Courseforge/exports", "role": "external-var"},
    {"pattern": "Courseforge/exports/**", "role": "external-var"},
    {"pattern": "SemantiK/inputs", "role": "external-var"},
    {"pattern": "SemantiK/inputs/**", "role": "external-var"},
    {"pattern": "SemantiK/output", "role": "external-var"},
    {"pattern": "SemantiK/output/**", "role": "external-var"},
    {"pattern": "SemantiK/batch_output", "role": "external-var"},
    {"pattern": "SemantiK/batch_output/**", "role": "external-var"},
    {"pattern": "Trainforge/output", "role": "external-var"},
    {"pattern": "Trainforge/output/**", "role": "external-var"},
    {"pattern": "LibV2/courses", "role": "external-var"},
    {"pattern": "LibV2/courses/**", "role": "external-var"},
    {"pattern": "LibV2/catalog", "role": "external-var"},
    {"pattern": "LibV2/catalog/**", "role": "external-var"}
  ],
  "allowed_children": {
    "agent-tooling": ["agent-tooling", "tests", "fixtures"],
    "ci": ["ci", "tests", "fixtures"],
    "surface": ["surface", "package", "tests", "fixtures", "templates"],
    "contracts": ["contracts", "tests", "fixtures"],
    "docs": ["docs"],
    "package": ["package", "tests", "fixtures", "templates"],
    "subsystem": ["subsystem", "package", "tools", "docs", "contracts", "tests", "fixtures", "templates", "external-var"],
    "tools": ["tools", "package", "tests", "fixtures", "templates"],
    "tests": ["tests", "fixtures", "templates"],
    "fixtures": ["fixtures", "templates"],
    "templates": ["templates"],
    "external-var": ["external-var"]
  },
  "source_roles": ["agent-tooling", "ci", "surface", "contracts", "docs", "package", "subsystem", "tools", "tests", "fixtures", "templates"],
  "sentinel_names": [".gitkeep"],
  "max_source_bytes": 50000000,
  "forbidden_generated_segments": ["build", "dist", "generated", "artifacts", "checkpoints", "weights"]
}
