# Machine-local demo settings. Copy to `.env` (gitignored) and set your course.
#   cp demo.env.example .env && edit .env
# Then either `set -a; . ./.env; set +a` before running provision.py, or pass
# the same values as --slug / --cartridge flags. The course slug is machine-local
# demo data and is intentionally NOT hardcoded in any tracked file.

# Course slug to provision into OpenOLAT (must exist under LibV2/courses/<slug>/).
ED4ALL_DEMO_SLUG=your-course-slug

# Optional: override the cartridge path (defaults to
#   LibV2/courses/<slug>/source/imscc/<slug>.imscc ).
# ED4ALL_DEMO_CARTRIDGE=/abs/path/to/course.imscc

# Widget backend base URL (the Ed4All GUI stack).
ED4ALL_WIDGET_BASE=http://localhost:8077

# Credentials (never commit real values). OpenOLAT admin default is
# administrator / openolat on first boot — change it before any exposure.
# OLAT_ADMIN_PASS=openolat
# OLAT_LEARNER_PASS=demo-learner-pw
# OLAT_LEARNER_EMAIL=demo-learner@example.com
