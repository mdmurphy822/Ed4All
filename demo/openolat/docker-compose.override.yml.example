# Copy to docker-compose.override.yml (gitignored) and edit for this host.
# `docker compose up` auto-merges it. Examples:
#
# services:
#   openolat:
#     ports:
#       - "18080:8080"          # remap if 8080 is taken on this host
#     environment:
#       CATALINA_OPTS: "-Xmx4096m"   # bigger heap
#   openolat-db:
#     environment:
#       POSTGRES_PASSWORD: "a-strong-demo-password"   # then mirror in olat.local.properties + openolat.xml
