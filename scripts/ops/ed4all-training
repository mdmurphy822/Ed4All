#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
python_bin="${repo_dir}/.venv-training/bin/python"
if [[ ! -x "${python_bin}" ]]; then
  echo "missing repo-managed training runtime: ${python_bin}" >&2
  echo "run scripts/ops/bootstrap-training-env.sh first" >&2
  exit 2
fi
exec "${python_bin}" -m cli.main "$@"
