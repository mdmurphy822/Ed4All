# Build-context excludes. Everything here is either a runtime VOLUME (mounted at
# /data via ED4ALL_HOME, never baked into the image) or build cruft. Source
# needed by `pip install -e .` (lib/, MCP/, cli/, gui/, pyproject.toml,
# README.md) is intentionally NOT excluded.
venv/
.venv/
.venv-gui/
__pycache__/
*.pyc
.git/
.github/
.pytest_cache/
htmlcov/
*.egg-info/

# Planning / scratch — not shipped in the image.
plans/
plan/

# Local data dirs — these are /data volumes at runtime, not image content.
runtime/
Trainforge/output/
Courseforge/exports/
Courseforge/inputs/exam-objectives/*.json
Courseforge/inputs/textbooks/
Courseforge/inputs/existing-packages/
Courseforge/inputs/course-data/*.json
SemantiK/output/
SemantiK/batch_output/
SemantiK/inputs/
LibV2/courses/
LibV2/catalog/

# Local Claude state.
.claude/
